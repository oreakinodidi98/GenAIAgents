apim_resource_gateway_url=https://YOUR-APIM-GATEWAY.azure-api.net
openai_api_version=YOUR-OPENAI-API-VERSION
openai_deployment_name=YOUR-OPENAI-DEPLOYMENT
openai_model_name=YOUR-OPENAI-MODEL
apim_subscription_key=YOUR-APIM-SUBSCRIPTION-KEY


AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_CHAT_COMPLETIONS_DEPLOYMENT_NAME=<your-chat-completions-deployment-name>
AZURE_OPENAI_EMBEDDING_MODEL=<your-embedding-model>
EMBEDDING_VECTOR_DIMENSIONS=<your-embedding-vector-dimensions> # e.g., 3072 for text-embedding-3-small

AZURE_SEARCH_SERVICE_ENDPOINT=<your-azure-search-service-endpoint>
AZURE_SEARCH_SERVICE_ADMIN_KEY=<your-azure-search-service-admin-key>
SEARCH_INDEX_NAME=<your-search-index-name> # e.g., index-doc-dev-uks-oa-hol-01